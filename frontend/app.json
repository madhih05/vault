{
  "expo": {
    "name": "Vault",
    "slug": "vault",
    "scheme": "vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "in.madhih.vault",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://secretvault.madhih.in"
    }
  }
}
